--[[
	MapService
	Builds the static world at server start: ground, conveyor, portals,
	spawn, decorations and lighting. Player bases are built by PlotService.
	Everything is generated by code, so the place file can stay empty.
]]

local Lighting = game:GetService("Lighting")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

local MapService = {}

local MAP = GameConfig.Map
local HALF_CONVEYOR = MAP.ConveyorLength / 2

MapService.BeltHeight = 0.4
MapService.ConveyorStart = Vector3.new(-HALF_CONVEYOR, MapService.BeltHeight, 0)
MapService.ConveyorEnd = Vector3.new(HALF_CONVEYOR, MapService.BeltHeight, 0)

local function newPart(props, parent: Instance): BasePart
	local part = Instance.new(props.ClassName or "Part") :: BasePart
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		if key ~= "ClassName" then
			(part :: any)[key] = value
		end
	end
	part.Parent = parent
	return part
end

MapService.NewPart = newPart

local function registerCollisionGroups()
	for _, name in { "Players", "Critters", "Decor" } do
		if not PhysicsService:IsCollisionGroupRegistered(name) then
			PhysicsService:RegisterCollisionGroup(name)
		end
	end
	-- Critters walk through players, each other and props; they only stand on the ground.
	PhysicsService:CollisionGroupSetCollidable("Critters", "Players", false)
	PhysicsService:CollisionGroupSetCollidable("Critters", "Critters", false)
	PhysicsService:CollisionGroupSetCollidable("Critters", "Decor", false)
end

local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.5
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 160)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local atmosphere = Instance.new("Atmosphere")
		atmosphere.Density = 0.25
		atmosphere.Haze = 0.5
		atmosphere.Color = Color3.fromRGB(200, 220, 255)
		atmosphere.Decay = Color3.fromRGB(140, 170, 220)
		atmosphere.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("BloomEffect") then
		local bloom = Instance.new("BloomEffect")
		bloom.Intensity = 0.4
		bloom.Size = 20
		bloom.Threshold = 1.5
		bloom.Parent = Lighting
	end
end

local function makeSurfaceText(part: BasePart, face: Enum.NormalId, text: string, color: Color3)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.Parent = gui
	gui.Parent = part
end

local function buildPortal(folder: Folder, x: number, text: string, color: Color3)
	local width = MAP.ConveyorWidth + 4
	for _, side in { -1, 1 } do
		newPart({
			Name = "Pillar",
			Size = Vector3.new(2, 14, 2),
			CFrame = CFrame.new(x, 7, side * width / 2),
			Color = color,
			Material = Enum.Material.Neon,
		}, folder)
	end
	local top = newPart({
		Name = "PortalTop",
		Size = Vector3.new(2, 4, width + 2),
		CFrame = CFrame.new(x, 15, 0),
		Color = Color3.fromRGB(35, 35, 45),
	}, folder)
	makeSurfaceText(top, Enum.NormalId.Left, text, color)
	makeSurfaceText(top, Enum.NormalId.Right, text, color)
end

local function buildTree(folder: Folder, position: Vector3, size: number)
	newPart({
		Name = "Trunk",
		Size = Vector3.new(1.5, 8, 1.5) * size,
		CFrame = CFrame.new(position + Vector3.new(0, 4 * size, 0)),
		Color = Color3.fromRGB(110, 75, 45),
		Material = Enum.Material.Wood,
	}, folder)
	newPart({
		Name = "Leaves",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 9 * size,
		CFrame = CFrame.new(position + Vector3.new(0, 10 * size, 0)),
		Color = Color3.fromRGB(70, 160, 70),
		Material = Enum.Material.Grass,
	}, folder)
end

function MapService.Init()
	registerCollisionGroups()
	setupLighting()

	-- The default template parts would overlap the generated map.
	for _, name in { "Baseplate", "SpawnLocation" } do
		local existing = workspace:FindFirstChild(name)
		if existing and existing:IsA("BasePart") then
			existing:Destroy()
		end
	end

	local folder = Instance.new("Folder")
	folder.Name = "Map"
	folder.Parent = workspace

	local groundSize = Vector3.new(440, 4, 220)
	newPart({
		Name = "Ground",
		Size = groundSize,
		CFrame = CFrame.new(0, -2, 0),
		Color = Color3.fromRGB(96, 180, 86),
		Material = Enum.Material.Grass,
	}, folder)

	-- Invisible boundary walls.
	for _, wall in
		{
			{ Vector3.new(groundSize.X, 80, 2), Vector3.new(0, 40, groundSize.Z / 2 + 1) },
			{ Vector3.new(groundSize.X, 80, 2), Vector3.new(0, 40, -groundSize.Z / 2 - 1) },
			{ Vector3.new(2, 80, groundSize.Z), Vector3.new(groundSize.X / 2 + 1, 40, 0) },
			{ Vector3.new(2, 80, groundSize.Z), Vector3.new(-groundSize.X / 2 - 1, 40, 0) },
		}
	do
		newPart({ Name = "Boundary", Size = wall[1], CFrame = CFrame.new(wall[2]), Transparency = 1 }, folder)
	end

	-- Conveyor belt.
	local beltFolder = Instance.new("Folder")
	beltFolder.Name = "Conveyor"
	beltFolder.Parent = folder

	newPart({
		Name = "Belt",
		Size = Vector3.new(MAP.ConveyorLength + 8, MapService.BeltHeight, MAP.ConveyorWidth),
		CFrame = CFrame.new(0, MapService.BeltHeight / 2, 0),
		Color = Color3.fromRGB(45, 45, 52),
		Material = Enum.Material.DiamondPlate,
	}, beltFolder)

	for x = -HALF_CONVEYOR + 6, HALF_CONVEYOR - 6, 12 do
		newPart({
			Name = "Stripe",
			Size = Vector3.new(1.2, 0.05, MAP.ConveyorWidth - 1),
			CFrame = CFrame.new(x, MapService.BeltHeight + 0.025, 0),
			Color = Color3.fromRGB(255, 205, 50),
			CanCollide = false,
		}, beltFolder)
	end

	for _, side in { -1, 1 } do
		newPart({
			Name = "Rail",
			Size = Vector3.new(MAP.ConveyorLength + 8, 0.8, 0.8),
			CFrame = CFrame.new(0, 0.4, side * (MAP.ConveyorWidth / 2 + 0.4)),
			Color = Color3.fromRGB(255, 205, 50),
			CanCollide = false,
		}, beltFolder)
	end

	buildPortal(folder, -HALF_CONVEYOR - 1, "NEW CRITTERS", Color3.fromRGB(170, 90, 255))
	buildPortal(folder, HALF_CONVEYOR + 1, "BYE BYE!", Color3.fromRGB(255, 90, 120))

	-- Spawn.
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "MainSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(14, 1, 14)
	spawn.CFrame = CFrame.new(-HALF_CONVEYOR - 35, 0.5, 0)
	spawn.Color = Color3.fromRGB(80, 170, 255)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Neutral = true
	spawn.Duration = 2
	spawn.Parent = folder

	-- Floating title.
	local titleAnchor = newPart({
		Name = "Title",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(-HALF_CONVEYOR - 35, 22, 0),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	}, folder)
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(46, 10)
	billboard.LightInfluence = 0
	billboard.MaxDistance = 400
	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromScale(1, 1)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.Text = string.upper(GameConfig.GameName)
	title.TextColor3 = Color3.fromRGB(255, 220, 60)
	title.TextStrokeTransparency = 0
	title.Parent = billboard
	billboard.Parent = titleAnchor

	-- Trees around the play area.
	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = folder
	local random = Random.new(42)
	for x = -200, 200, 32 do
		for _, side in { -1, 1 } do
			buildTree(decor, Vector3.new(x + random:NextNumber(-6, 6), 0, side * random:NextNumber(92, 104)), random:NextNumber(0.8, 1.3))
		end
	end
	for _, x in { -205, 205 } do
		for _, z in { -70, -40, 40, 70 } do
			buildTree(decor, Vector3.new(x, 0, z + random:NextNumber(-5, 5)), random:NextNumber(0.9, 1.4))
		end
	end

	-- Folder for critters walking on the conveyor.
	local conveyorUnits = Instance.new("Folder")
	conveyorUnits.Name = "ConveyorCritters"
	conveyorUnits.Parent = workspace
	MapService.ConveyorFolder = conveyorUnits
end

return MapService
